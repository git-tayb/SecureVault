# ---------- BACKEND (backend/.env) — server-side only, never commit ----------
PORT=4000
NODE_ENV=development
TRUST_PROXY=0
# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
SUPABASE_URL=https://[REF].supabase.co
# service_role key: backend ONLY. Never expose via NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=encrypted-files
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# 32 random bytes (Key Encryption Key): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
MAX_FILE_MB=10

# ---------- FRONTEND (frontend/.env.local) — non-secret ----------
BACKEND_URL=http://localhost:4000
